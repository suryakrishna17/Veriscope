# Copy to .env and adjust. Every setting has a safe development default.
APP_ENV=dev                      # dev | test | prod  (prod refuses the default SECRET_KEY)
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_PATH=./backend/var/veriscope.db
STORAGE_PATH=./backend/var/storage
MAX_UPLOAD_MB=10
MAX_PAGES=20
OCR_ENABLED=true
OCR_LANG=eng
# Windows example: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
LLM_PROVIDER=none                # none | mock | openai_compatible | anthropic | groq
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
GROQ_API_KEY=
GROQ_OCR_ENABLED=false
ISSUER_VERIFIER=null             # null | mock  (mock is a clearly labelled SIMULATION)
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
SYNC_JOBS=false
SEED_DEMO=true

# Security & Sandbox Controls
RATE_LIMIT_ENABLED=true
DIGILOCKER_SANDBOX=false
VITE_DEMO_MODE=false
